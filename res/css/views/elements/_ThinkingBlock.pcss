.mx_ThinkingBlock {
    margin: 8px 0;
    border: 1px solid $quinary-content;
    border-radius: 8px;
    background-color: $background;
    overflow: hidden;

    .mx_ThinkingBlock_header {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 12px;
        background-color: rgba($accent, 0.1);
        border: none;
        cursor: pointer;
        font-size: var(--cpd-font-body-md-regular);
        font-family: inherit;
        text-align: left;
        transition: background-color 0.2s ease;

        &:hover {
            background-color: rgba($accent, 0.15);
        }

        &:active {
            background-color: rgba($accent, 0.2);
        }
    }

    .mx_ThinkingBlock_chevron {
        flex-shrink: 0;
        transition: transform 0.2s ease;
        color: $secondary-content;

        &.mx_ThinkingBlock_chevron--expanded {
            transform: rotate(180deg);
        }
    }

    .mx_ThinkingBlock_label {
        flex: 1;
        font-weight: var(--cpd-font-weight-semibold);
        color: $primary-content;
    }

    .mx_ThinkingBlock_hint {
        font-size: var(--cpd-font-body-sm);
        color: $secondary-content;
        font-style: italic;
    }

    .mx_ThinkingBlock_content {
        padding: 12px;
        border-top: 1px solid $quinary-content;
        background-color: rgba($system, 0.05);
        color: $secondary-content;
        font-size: var(--cpd-font-body-md-regular);
        line-height: 1.5;
        max-height: 400px;
        overflow-y: auto;
        
        /* Style for nested code blocks */
        pre, code {
            background-color: rgba($system, 0.1);
            border-radius: 4px;
            padding: 2px 4px;
        }

        pre {
            padding: 8px;
            overflow-x: auto;
        }

        /* Ensure proper spacing for paragraphs */
        p {
            margin: 0.5em 0;
            
            &:first-child {
                margin-top: 0;
            }
            
            &:last-child {
                margin-bottom: 0;
            }
        }
    }
}