.mx_MindroomLongTextBody_spinner {
    display: inline-flex;
    align-items: center;
    margin-left: var(--cpd-space-2x);
    vertical-align: middle;
}

.mx_MindroomLongTextBody_spinner .mx_Spinner_icon {
    width: 14px;
    height: 14px;
}

.mx_MindroomLongTextBody_error {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-medium);
    margin-top: var(--cpd-space-2x);
    display: flex;
    gap: var(--cpd-space-2x);
    align-items: center;
}

.mx_MindroomLongTextBody_error .mx_AccessibleButton_kind_link_inline {
    font: inherit;
}
